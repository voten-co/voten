COMPOSE_PROJECT_NAME=voten-demo
DEMO_DOMAIN=voten.example.com

APP_NAME=Voten
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_LOG_LEVEL=warning
APP_URL=https://voten.example.com
FAVICON_PATH=/imgs/favicon.png
DEMO_MODE=true

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=voten
DB_USERNAME=voten
DB_PASSWORD=__DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__

BROADCAST_SERVICE=pusher
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
DISK_DRIVER=public
SESSION_DRIVER=redis
QUEUE_CONNECTION=database

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=demo@voten.example.com
MAIL_FROM_NAME=Voten Demo

PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_ID=
PUSHER_APP_CLUSTER=eu

SCOUT_DRIVER=null
ALGOLIA_APP_ID=
ALGOLIA_SECRET=

CDN_URL=https://voten.example.com/storage
FFMPEG_BINARIES=/usr/bin/ffmpeg
FFMPEG_DISK_DRIVER=public
FFMPEG_THREADS=1
FFPROBE_BINARIES=/usr/bin/ffprobe

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://voten.example.com/login/google/callback

GOOGLE_RECAPTCHA_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
SENTRY_LARAVEL_DSN=

DEMO_ADMIN_PASSWORD=__DEMO_ADMIN_PASSWORD__
DEMO_USER_PASSWORD=__DEMO_USER_PASSWORD__
